# Copy to .env (repo root). apps/api and packages/db both read it.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres (docker compose up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/huquq
# Used by API integration tests. Tests TRUNCATE tables, so never point this at real data.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/huquq_test

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-string
# Public base URL of this API (no trailing slash, no /v1).
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins allowed for CORS and Better Auth (web app, Expo dev server).
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081,huquq://

# Social sign-in (optional; a provider is enabled only when both values are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Native iOS bundle id, used to verify Apple ID tokens from the app.
APPLE_APP_BUNDLE_IDENTIFIER=

# pg-boss background jobs
JOBS_ENABLED=true
