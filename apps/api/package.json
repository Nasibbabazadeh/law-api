    "better-auth": "^1.7.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "nestjs-pino": "^5.2.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
