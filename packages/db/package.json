{
  "name": "@huquq/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations and client factory for Hüquq.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@huquq/core": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@huquq/eslint-config": "workspace:*",
    "@huquq/tsconfig": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
